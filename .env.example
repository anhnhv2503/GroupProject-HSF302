# Copy this file to .env and fill in real values. Do NOT commit .env.
#
# Loading it: use the EnvFile plugin in IntelliJ, or from a shell:
#   set -a && source .env && set +a && ./mvnw spring-boot:run

# --- Database (SQL Server) ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=SeafoodStoreDB;encrypt=false
DB_USERNAME=sa
DB_PASSWORD=

# --- Application base URL ---
# PayOS uses this to send the customer back after payment.
APP_BASE_URL=http://localhost:8080

# --- PayOS (https://my.payos.vn) ---
# checksumKey is the secret used to verify webhook signatures. Treat it like a password.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Cloudinary (https://cloudinary.com/console) ---
CLOUD_NAME=
API_KEY=
API_SECRET=
